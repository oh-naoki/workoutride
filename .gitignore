frontend/ios/Flutter/app.zip
frontend/ios/Flutter/flutter_assets/
frontend/ios/Flutter/flutter_export_environment.sh
frontend/ios/ServiceDefinitions.json
frontend/ios/Runner/GeneratedPluginRegistrant.*

# macOS
frontend/**/Flutter/ephemeral/
frontend/**/Pods/
frontend/**/macos/Flutter/GeneratedPluginRegistrant.swift
frontend/**/macos/Flutter/ephemeral
frontend/**/xcuserdata/

# Windows
frontend/**/windows/flutter/ephemeral/
frontend/**/windows/flutter/generated_plugin_registrant.cc
frontend/**/windows/flutter/generated_plugin_registrant.h
frontend/**/windows/flutter/generated_plugins.cmake

# Linux
frontend/**/linux/flutter/ephemeral/
frontend/**/linux/flutter/generated_plugin_registrant.cc
frontend/**/linux/flutter/generated_plugin_registrant.h
frontend/**/linux/flutter/generated_plugins.cmake

# Backend (Rails) specific
backend/.bundle/
backend/log/*
backend/tmp/*
!/backend/log/.keep
!/backend/tmp/.keep
backend/tmp/pids/*
!/backend/tmp/pids/
!/backend/tmp/pids/.keep
backend/storage/*
!/backend/storage/.keep
backend/tmp/storage/*
!/backend/tmp/storage/
!/backend/tmp/storage/.keep
backend/public/assets
backend/.byebug_history
backend/config/master.key
backend/config/credentials/*.key
backend/public/packs
backend/public/packs-test
backend/node_modules
backend/yarn-error.log
backend/yarn-debug.log*
backend/.yarn-integrity
backend/.env.development
backend/.env.test
backend/.env.production
backend/test_auth_manual.md

# Coverage
coverage/

# Exceptions to above rules.
!frontend/ios/**/default.mode1v3
!frontend/ios/**/default.mode2v3
!frontend/ios/**/default.pbxuser
!frontend/ios/**/default.perspectivev3
!.vscode/settings.json
