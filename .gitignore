# Do not remove or rename entries in this file, only add new ones
# See https://github.com/flutter/flutter/issues/128635 for more context.

# Common
.DS_Store
.history
.svn/
*.log
*.swp
.vscode/*
.idea/

# Frontend (Flutter) specific
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/**/generated_plugin_registrant.dart
frontend/.packages
frontend/.pub-preload-cache/
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/flutter_*.png
frontend/linked_*.ds
frontend/unlinked.ds
frontend/unlinked_spec.ds

# Android related
frontend/android/**/gradle-wrapper.jar
frontend/.gradle/
frontend/android/captures/
frontend/android/gradlew
frontend/android/gradlew.bat
frontend/android/local.properties
frontend/android/**/GeneratedPluginRegistrant.java
frontend/android/key.properties
frontend/android/app/.cxx/
frontend/*.jks

# iOS/XCode related
frontend/ios/**/*.mode1v3
frontend/ios/**/*.mode2v3
